{
  "name": "unreleased",
  "version": "2.6.52",
  "description": "Desktop player for the Juice WRLD catalogue, with playlists, synced lyrics and cover-inspired themes.",
  "desktopName": "com.juicewrldapi.player.desktop",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3018 && electron . --remote-debugging-port=9222\"",
    "dev": "vite --port 3018 --strictPort --host",
    "build": "tsc --noEmit && vite build",
    "typecheck:electron": "tsc -p tsconfig.electron.json",
    "test:electron": "node --test electron/*.test.js",
    "test:scripts": "node --test scripts/*.test.cjs",
    "test:platform": "node --test electron/platform.test.js",
    "test:offline-library": "node --test electron/offlineLibrary.test.js",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3018 && electron .\"",
    "electron:dev:debug": "concurrently \"npm run dev\" \"wait-on http://localhost:3018 && electron . --remote-debugging-port=9222\"",
    "electron:dev:wayland": "concurrently \"npm run dev\" \"wait-on http://localhost:3018 && electron . --ozone-platform=wayland\"",
    "electron:dev:x11": "concurrently \"npm run dev\" \"wait-on http://localhost:3018 && electron . --ozone-platform=x11\"",
    "electron:build": "npm run build && electron-builder",
    "electron:smoke": "electron . --smoke-test",
    "ui:verify": "node scripts/ui-verify.mjs",
    "ui:discover": "node scripts/ui-discover.cjs",
    "ui:motion": "node scripts/motion-audit.mjs",
    "terminal:check-coverage": "node scripts/check-terminal-coverage.mjs"
  },
  "keywords": [],
  "author": "leanwrldd",
  "license": "MIT",
  "private": true,
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "electron-updater": "^6.8.9",
    "music-metadata": "^11.13.0",
    "node-id3": "^0.2.9"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@webgpu/types": "^0.1.74",
    "autoprefixer": "^10.4.20",
    "browser-id3-writer": "^6.4.0",
    "client-zip": "^2.5.1",
    "concurrently": "^10.0.3",
    "electron": "^42.9.2",
    "electron-builder": "^26.15.3",
    "ffmpeg-static": "^5.3.0",
    "jsmediatags": "^3.9.7",
    "libsodium-wrappers": "^0.8.4",
    "lucide-react": "^0.469.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.3.5",
    "wait-on": "^9.0.10",
    "youtube-dl-exec": "^3.1.9",
    "zustand": "^5.0.14"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "@discordjs/rest": {
      "undici": "6.29.0"
    },
    "@electron/get": {
      "undici": "7.30.0"
    }
  },
  "build": {
    "appId": "com.goodfight37.unreleased.glasslab",
    "productName": "Unreleased Glass",
    "icon": "electron/icon.ico",
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "THIRD-PARTY-NOTICES.md",
        "to": "THIRD-PARTY-NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      }
    ],
    "files": [
      "**/*",
      "!src/**/*",
      "!electron/*.test.js",
      "!build/**/*",
      "!out/**/*",
      "!release/**/*",
      "!beta-builds/**/*",
      "!scripts/**/*",
      "!.ui-verify/**/*",
      "!.github/**/*",
      "!.git/**/*",
      "!.claude/**/*",
      "!.agents/**/*",
      "!.impeccable/**/*",
      "!docs/**/*",
      "!md/**/*",
      "!node_modules/.bin/**/*",
      "!**/*.bat",
      "!**/*.cmd",
      "!**/*.log",
      "!**/*.d.ts",
      "!**/*.map",
      "!.env*",
      "!**/*.md",
      "!tsconfig*.json",
      "!*.tsbuildinfo",
      "!postcss.config.js",
      "!tailwind.config.js",
      "!vite.config.ts",
      "!icons/**/*",
      "!dist/robots.txt",
      "!dist/sitemap.xml",
      "!dist/sw.js",
      "!dist/manifest.webmanifest",
      "!**/.DS_Store",
      "!**/Thumbs.db"
    ],
    "mac": {
      "identity": null,
      "icon": "resources/icon-512.png",
      "category": "public.app-category.music",
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Identify songs from a short microphone recording when you choose Listen."
      },
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "extraResources": [
        {
          "from": "electron/icon.ico",
          "to": "icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "resources/icon-512.png",
      "category": "Audio",
      "syncDesktopName": true,
      "target": [
        "AppImage"
      ],
      "artifactName": "${productName}-${version}.${ext}"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "publish": {
      "provider": "github",
      "owner": "GoodFight37",
      "repo": "Unreleased"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "ffmpeg-static@5.3.0": true,
    "youtube-dl-exec@3.1.9": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GoodFight37/Unreleased.git"
  }
}
